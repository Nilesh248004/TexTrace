# --- Server ---
API_PORT=4000
# SQLite database file (created + seeded automatically on first start)
DB_FILE=server/data/textrace.db
# Optional Neon PostgreSQL connection string. When set, Neon is the active database (schema is applied on start).
# Use the pooled host and sslmode=verify-full, e.g.
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL=
# Mill name shown in the top bar
MILL_NAME=Model Spinning Mill — Unit 1

# --- AI narrative layer (optional). Without a key the statistical engine still runs and the UI shows "AI narrative disabled".
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_MS=60000
# Server-side refusal fallback (beta). Set to "off" to disable.
AI_FALLBACKS=default

# --- Ledger ---
# Ledger adapter: "simulated" (built-in permissioned ledger). Future: "fabric" | "besu".
LEDGER_ADAPTER=simulated
# HMAC secret base for the simulated validators (change in production)
LEDGER_VALIDATOR_SECRET=textrace-demo-validators
